+      { "pvr_mesa_wsi_common_get_present_rectangles",
+            pvr_mesa_wsi_common_get_present_rectangles },
+#if defined(VK_USE_PLATFORM_WAYLAND_KHR)
+      { "pvr_mesa_wsi_get_physical_device_wayland_presentation_support",
+            pvr_mesa_wsi_get_physical_device_wayland_presentation_support },
+      { "pvr_mesa_wsi_create_wayland_surface",
+            pvr_mesa_wsi_create_wayland_surface },
