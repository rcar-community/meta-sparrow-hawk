diff --git a/meson.build b/meson.build
index a361e216e63..8f5e3ac9d8a 100644
--- a/meson.build
+++ b/meson.build
@@ -276,6 +276,7 @@ with_imagination_vk = _vulkan_drivers.contains('imagination-experimental')
 with_imagination_srv = get_option('imagination-srv')
 with_microsoft_vk = _vulkan_drivers.contains('microsoft-experimental')
 with_nouveau_vk = _vulkan_drivers.contains('nouveau-experimental')
+with_pvr_vk = _vulkan_drivers.contains('pvr')
 with_any_vk = _vulkan_drivers.length() != 0
 
 with_vk_compiler = [
@@ -351,6 +352,21 @@ if with_aco_tests and not with_amd_vk
   error('ACO tests require Radv')
 endif
 
+if with_pvr_vk
+  pvr_vulkan_display = get_option('pvr-vulkan-display')
+  if pvr_vulkan_display == ''
+    if with_gallium_pvr_alias
+      pvr_vulkan_display = gallium_pvr_alias
+    endif
+  elif pvr_vulkan_display == 'pvr'
+    pvr_vulkan_display = ''
+  endif
+  with_pvr_vulkan_display = pvr_vulkan_display != ''
+else
+  pvr_vulkan_display = ''
+  with_pvr_vulkan_display = false
+endif
+
 with_microsoft_clc = get_option('microsoft-clc').enabled()
 with_clc = with_microsoft_clc or with_intel_clc or with_gallium_asahi
 with_spirv_to_dxil = get_option('spirv-to-dxil')
