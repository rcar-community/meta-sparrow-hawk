+static inline uint32_t
+pvr_vk_wsi_get_version(struct pvr_mesa_wsi *mwsi)
+{
+   JUMP_DDK(mwsi, pvr_vk_mesa_wsi_get_version,
+                  mwsi->physicalDevice);
+
+   return 0;
+}
+
+
+static bool
+pvr_mesa_wsi_can_present_on_device(VkPhysicalDevice pdevice, int fd)
+{
+   drmVersionPtr version = drmGetVersion(fd);
+   bool ret = false;
+
+   if (!version)
+      return ret;
+
+   if (version->name_len) {
+#if defined(PVR_DISPLAY_DRIVER_STRING)
+      ret = !strcmp(version->name, PVR_DISPLAY_DRIVER_STRING);
+#endif
+      if (!ret)
+         ret = !strcmp(version->name, "pvr");
+   }
+
+   drmFreeVersion(version);
+
+   return ret;
+}
+
+VkResult
+pvr_mesa_wsi_init(struct pvr_mesa_wsi **pmwsi,
+                  VkPhysicalDevice physicalDevice,
+                  PFN_vkVoidFunction (VKAPI_PTR *pvr_vk_mesa_wsi_sym_addr)
+                     (VkPhysicalDevice physicalDevice, const char *),
+                  const VkAllocationCallbacks *alloc,
+                  int fd,
+                  bool sw)
+{
+   struct pvr_mesa_wsi *mwsi;
+   VkResult result;
+   struct vk_device_extension_table extensions;
+   const struct wsi_device_options options = { .sw_device = sw };
+
+   mwsi = vk_zalloc(alloc, sizeof(*mwsi), 8,
+                    VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!mwsi)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   mwsi->symtab.pvr_vk_mesa_wsi_sym_addr = pvr_vk_mesa_wsi_sym_addr;
+   mwsi->physicalDevice = physicalDevice;
+
+   mwsi->pvr_vk_wsi_version = pvr_vk_wsi_get_version(mwsi);
+   if (mwsi->pvr_vk_wsi_version < 1) {
+      vk_free(alloc, mwsi);
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   pvr_mesa_wsi_device_extensions(mwsi, &extensions);
+
+   result = wsi_device_init2(&mwsi->wsi,
+                             physicalDevice,
+                             pvr_vk_mesa_wsi_sym_addr,
+                             alloc,
+                             fd, NULL, &options,
+                             true, &extensions);
+   if (result != VK_SUCCESS) {
+      vk_free(alloc, mwsi);
+      return result;
+   }
+
+   if (!sw)
+      mwsi->wsi.supports_modifiers = true;
+
+   mwsi->wsi.can_present_on_device = &pvr_mesa_wsi_can_present_on_device;
+
+   *pmwsi = mwsi;
+
+   return VK_SUCCESS;
+}
