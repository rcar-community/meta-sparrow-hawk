From d29a2ecf554644a832c0439c89ad6722e5e416de Mon Sep 17 00:00:00 2001
From: Brendan King <Brendan.King@imgtec.com>
Date: Tue, 30 Jan 2018 10:25:11 +0000
Subject: [PATCH 21/71] GL_EXT_multi_draw_indirect entry points

Upstream-Status: Inappropriate [oe specific]

---
 src/mapi/glapi/gen/es_EXT.xml     | 19 +++++++++++++++++++
 src/mapi/glapi/gen/static_data.py |  2 ++
 2 files changed, 21 insertions(+)

diff --git a/src/mapi/glapi/gen/es_EXT.xml b/src/mapi/glapi/gen/es_EXT.xml
index 0123ff99cd2..fe38ad2331c 100644
--- a/src/mapi/glapi/gen/es_EXT.xml
+++ b/src/mapi/glapi/gen/es_EXT.xml
@@ -1224,6 +1224,25 @@
 
 </category>
 
+<category name="GL_EXT_multi_draw_indirect" number="205">
+
+    <function name="MultiDrawArraysIndirectEXT" es2="3.1" exec="dynamic">
+        <param name="mode" type="GLenum"/>
+        <param name="indirect" type="const GLvoid *"/>
+        <param name="drawcount" type="GLsizei"/>
+        <param name="stride" type="GLsizei"/>
+    </function>
+
+    <function name="MultiDrawElementsIndirectEXT" es2="3.1" exec="dynamic">
+        <param name="mode" type="GLenum"/>
+        <param name="type" type="GLenum"/>
+        <param name="indirect" type="const GLvoid *"/>
+        <param name="drawcount" type="GLsizei"/>
+        <param name="stride" type="GLsizei"/>
+    </function>
+
+</category>
+
 <category name="GL_EXT_copy_image" number="208">
 
     <function name="CopyImageSubDataEXT" alias="CopyImageSubData" es2="3.0">
diff --git a/src/mapi/glapi/gen/static_data.py b/src/mapi/glapi/gen/static_data.py
index f19c221c193..e82426bd62a 100644
--- a/src/mapi/glapi/gen/static_data.py
+++ b/src/mapi/glapi/gen/static_data.py
@@ -1718,6 +1718,8 @@ offsets = {
     "FramebufferTextureLayerDownsampleIMG" : 1682,
     "FramebufferTextureMultiviewOVR" : 1683,
     "FramebufferTextureMultisampleMultiviewOVR" : 1684,
+    "MultiDrawArraysIndirectEXT" : 1685,
+    "MultiDrawElementsIndirectEXT" : 1686,
 }
 
 functions = [
