From 94ede26c0736b19c132020396203cc18c25a35f3 Mon Sep 17 00:00:00 2001
From: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
Date: Tue, 30 Jun 2026 18:38:25 +0900
Subject: [PATCH] arm64: dts: renesas: sparrow-hawk: Add pcie-ep dtbo

Upstream-Status: Inappropriate [no upstream]

Signed-off-by: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
---
 arch/arm64/boot/dts/renesas/Makefile                   |  3 +++
 .../dts/renesas/r8a779g3-sparrow-hawk-pcie-ep.dtso     | 10 ++++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-pcie-ep.dtso

diff --git a/arch/arm64/boot/dts/renesas/Makefile b/arch/arm64/boot/dts/renesas/Makefile
index 5f4beccdfb6d..227be2614276 100644
--- a/arch/arm64/boot/dts/renesas/Makefile
+++ b/arch/arm64/boot/dts/renesas/Makefile
@@ -135,6 +135,9 @@ dtb-$(CONFIG_ARCH_R8A779G0) += r8a779g3-sparrow-hawk-rpi-display-2-7in.dtb
 dtb-$(CONFIG_ARCH_R8A779G0) += r8a779g3-sparrow-hawk-ws-display-13in.dtbo
 r8a779g3-sparrow-hawk-ws-display-13in-dtbs := r8a779g3-sparrow-hawk.dtb r8a779g3-sparrow-hawk-ws-display-13in.dtbo
 dtb-$(CONFIG_ARCH_R8A779G0) += r8a779g3-sparrow-hawk-ws-display-13in.dtb
+dtb-$(CONFIG_ARCH_R8A779G0) += r8a779g3-sparrow-hawk-pcie-ep.dtbo
+r8a779g3-sparrow-hawk-pcie-ep-dtbs := r8a779g3-sparrow-hawk.dtb r8a779g3-sparrow-hawk-pcie-ep.dtbo
+dtb-$(CONFIG_ARCH_R8A779G0) += r8a779g3-sparrow-hawk-pcie-ep.dtb
 
 dtb-$(CONFIG_ARCH_R8A779G0) += r8a779g3-white-hawk-single.dtb
 r8a779g3-white-hawk-single-ard-audio-da7212-dtbs := r8a779g3-white-hawk-single.dtb white-hawk-ard-audio-da7212.dtbo
diff --git a/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-pcie-ep.dtso b/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-pcie-ep.dtso
new file mode 100644
index 000000000000..db1d524a651b
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-pcie-ep.dtso
@@ -0,0 +1,10 @@
+/dts-v1/;
+/plugin/;
+
+&pciec0 {
+	status = "disabled";
+};
+
+&pciec0_ep {
+	status = "okay";
+};
