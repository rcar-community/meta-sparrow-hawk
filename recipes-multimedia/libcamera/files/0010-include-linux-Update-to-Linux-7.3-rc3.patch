 include/linux/drm.h                          |   7 +
 include/linux/drm_fourcc.h                   | 244 ++++++-
 include/linux/drm_mode.h                     |   1 +
 include/linux/media/dreamchip/rppx1-config.h | 730 +++++++++++++++++++
 include/linux/rkisp1-config.h                | 113 ++-
 include/linux/v4l2-controls.h                |   2 +
 include/linux/videodev2.h                    |   4 +
 utils/update-kernel-headers.sh               |   1 +
 9 files changed, 1078 insertions(+), 26 deletions(-)
