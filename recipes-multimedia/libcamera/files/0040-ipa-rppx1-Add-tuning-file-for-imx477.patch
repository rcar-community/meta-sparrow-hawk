+        - lux: 1500
+          ct: [ 2000, 4000, 6000, 6500, 7000, 13000 ]
+          probability: [ 0.00001, 1, 6, 7, 1, 1 ]
+      colourGains:
+        - ct: 2360
+          gains: [1.66417041, 3.23310702]
+        - ct: 2848
