+        - ct: 7763
+          gains: [3.38983051, 1.35135135]
+        - ct: 9505
+          gains: [3.96196513, 1.27291242]
+      transversePos: 0.0238
+      transverseNeg: 0.04429
+  - BlackLevelCorrection:
+  - Ccm:
+      ccms:
+        - ct: 2850
