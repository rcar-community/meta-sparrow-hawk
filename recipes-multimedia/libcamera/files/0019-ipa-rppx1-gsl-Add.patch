+RPPX1_DEFINE_BLOCK_TYPE(LinPre2, lin, LIN_PRE2)
 RPPX1_DEFINE_BLOCK_TYPE(WbMeasPost, wbmeas, WBMEAS_POST)
 
 struct params_traits {
